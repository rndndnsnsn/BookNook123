<%- include('partials/header', { title }) %>
<h1>New reading list</h1>
<% if (error) { %><p class="flash flash-error"><%= error %></p><% } %>
<form action="/lists" method="POST" class="panel form-narrow">
<label>Title <input name="title" value="<%= form.title || '' %>" placeholder="Books for a rainy weekend" required></label>
<label>Description <textarea name="description" rows="3"><%= form.description || '' %></textarea></label>
<button class="btn">Create list</button>
</form>
<%- include('partials/footer') %>
