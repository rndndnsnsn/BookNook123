<%- include('partials/header', { title }) %>
<h1>Authors</h1>
<div class="list-rows">
<% authors.forEach(a => { %>
<a class="row-card" href="/authors/<%= a.id %>">
<strong><%= a.name %></strong>
<span class="muted"><%= a.country || 'Unknown country' %>, <%= a.book_count %> book<%= a.book_count === 1 ? '' : 's' %></span>
</a>
<% }) %>
</div>
<%- include('partials/footer') %>
